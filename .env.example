# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key          # frontend / public reads
SUPABASE_SERVICE_KEY=your-supabase-service-role-key  # backend writes (bypasses RLS)

# ── LLMs ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── PoC sources ───────────────────────────────────────────────────────────────
# Miami 311 — no key required (Miami Open Data is public)

# Google Places — venue density
GOOGLE_PLACES_API_KEY=your-google-places-key

# Yelp Fusion — review text for RAG corpus
YELP_API_KEY=your-yelp-fusion-key

# Reddit PRAW — community posts for RAG corpus
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=mianoise/0.1 by your-reddit-username

# ── Full-version sources (omit to skip gracefully) ────────────────────────────
# TomTom Traffic
TOMTOM_API_KEY=your-tomtom-key

# OpenSky Network — flight path frequency
OPENSKY_USERNAME=your-opensky-username
OPENSKY_PASSWORD=your-opensky-password

# Construction permits — no key required (Miami Open Data is public)

# ── Optional ──────────────────────────────────────────────────────────────────
# Miami Open Data app token (raises rate limits; not required)
MIAMI_DATA_APP_TOKEN=your-socrata-app-token
